{
  "name": "evepad",
  "version": "0.7.3",
  "private": true,
  "description": "Local dashboard and build harness for eve agents",
  "homepage": "https://github.com/andrewckor/evepad#readme",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/andrewckor/evepad.git"
  },
  "type": "module",
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1 --port 5173",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1 --port 5173",
    "pack": "node scripts/build-package.mts",
    "postinstall": "chmod +x node_modules/node-pty/prebuilds/*/spawn-helper 2>/dev/null || true",
    "typecheck": "tsc --noEmit",
    "test": "node --test '**/*.test.ts'",
    "lint": "oxlint --deny-warnings",
    "lint:fix": "oxlint --fix",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "prepare": "node ./scripts/install-git-hooks.mjs"
  },
  "dependencies": {
    "@ai-sdk/gateway": "^4.0.52",
    "@base-ui/react": "^1.7.0",
    "@opencode-ai/sdk": "^1.18.18",
    "@shadcn/react": "^0.3.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "@xyflow/react": "^12.11.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "geist": "^1.7.2",
    "motion": "^13.1.0",
    "next": "^16.3.1",
    "node-pty": "^1.1.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "shadcn": "^4.18.0",
    "streamdown": "^2.5.0",
    "swr": "^2.5.1",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "vercel-geist-icons": "^1.2.2",
    "workflow": "^5.0.0-beta.41"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "oxfmt": "^0.64.0",
    "oxlint": "^1.79.0",
    "typescript": "^7.0.2"
  }
}
